# =====================================================================
# Variables de entorno para produccion (VPS)
# Copiar como .env en la VPS y completar los valores.
# NO commitear .env al repo.
# =====================================================================

# --- Base de datos ---
DB_USER=nibal_user
DB_PASSWORD=cambiame_por_password_largo
DB_NAME=nibal_db
DATABASE_URL=postgresql+asyncpg://nibal_user:cambiame_por_password_largo@nibal_db:5432/nibal_db

# --- Admin ---
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=cambiame_por_token_largo_y_random

# --- App ---
APP_ENV=prod
APP_BASE_URL=https://nibal.ink
STORAGE_PUBLIC_URL=https://assets.nibal.ink
STORAGE_LOCAL_PATH=assets

# --- QR ---
QR_FILL_COLOR=black
QR_BACK_COLOR=white
